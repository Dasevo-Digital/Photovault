/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            // ACHTUNG: CompanyName und ProductName bestimmen, WO die Daten
            // liegen. path_provider liest beide aus dieser Ressource und
            // baut daraus %APPDATA%\<CompanyName>\<ProductName>\ - hier
            // steht heute die Bibliothek unter
            // %APPDATA%\com.example\photo_vault\PhotoVault\.
            // Werden sie geaendert, sucht eine bereits benutzte
            // Installation an einer neuen Stelle und begruesst den Nutzer
            // mit dem Startbildschirm, als waere sie frisch. Nur zusammen
            // mit einer Umzugslogik aendern. Dasselbe gilt unter Linux fuer
            // APPLICATION_ID; dort ist es einmal passiert.
            VALUE "CompanyName", "com.example" "\0"
            // Der sichtbare Name in Explorer und Task-Manager. Der darf.
            VALUE "FileDescription", "Photo Vault" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "photo_vault" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Photo Vault. All rights reserved." "\0"
            VALUE "OriginalFilename", "photo_vault.exe" "\0"
            VALUE "ProductName", "photo_vault" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

