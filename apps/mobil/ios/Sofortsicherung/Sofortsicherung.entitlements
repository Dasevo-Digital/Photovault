<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dieselbe Gruppe wie App, Widget und Teilen (GemeinsameVerbindung.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PV_APP_KENNUNG).gemeinsam</string>
	</array>
</dict>
</plist>
