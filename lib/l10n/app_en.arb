  "einstBegriffHinzufuegen": "Add term",
  "einstOrteText": "Turns a photo's GPS position into country, state or province and city – entirely locally, via the nearest known city (GeoNames data), without asking an online map service. Needed for the country, state and city filters in the search options.",
  "einstGeoTitel": "GeoNames – cities, countries, states",
  "einstGeoText": "Cities from 1000 inhabitants worldwide (~10 MB). Licence: {lizenz}.",
  "einstGeoLoeschen": "Delete the GeoNames data",
  "einstGesperrtText": "Encrypts private photos with AES-256 – real encryption, not just a display filter – and hides them everywhere else (timeline, search, albums, people, map, backup). Without the PIN there is no way back.",
  "einstGesperrtEntsperrt": "PIN set up – already unlocked for this session.",
  "einstGesperrtOeffnen": "Open",
  "einstPinAendern": "Change PIN",
  "einstGesperrtAufloesenText": "Every photo in the locked folder is decrypted and becomes visible again everywhere (timeline, search, albums, people, map, backup). This cannot be undone.",
  "einstBackupVerschluesselungTitel": "Backup encryption",
  "einstBackupVerschluesselungText": "Lets you encrypt manual and automatic backups with AES-256. Its own passphrase, separate from the locked folder's PIN – a backup often ends up elsewhere and has to be decryptable without this machine.",
  "einstBackupEntsperrt": "Set up – already unlocked for this session.",
  "einstBackupGesperrt": "Set up – you will be asked at the next backup.",
  "einstBackupAendern": "Change",
  "einstBackupNieGesichert": "Never backed up.",
  "einstBackupVerschluesseln": "Encrypt backup",
  "einstBackupPassphraseAbfrage": "Asks for the backup passphrase above when needed.",
  "einstBackupZielWaehlen": "Choose a backup destination (e.g. your Dropbox or Google Drive folder)",
  "einstBackupOrdnerWaehlen": "Choose the backup folder (the one containing “PhotoVault-Backup” or “originals”)",
  "einstBackupEntschluesselnTitel": "Turn off backup encryption?",
  "einstBackupEntschluesselnText": "New backups will no longer be encrypted. Encrypted backups already at the destination stay as they are and remain decryptable only with the previous passphrase.",
  "einstBackupLaeuft": "Automatic backup running …",
  "einstBackupKeineNeuen": "No new files – refreshing the database snapshot.",
  "einstBackupZielHinweis": "Point this at your local Dropbox or Google Drive folder, for instance – that provider's desktop app then uploads the files to the cloud for you.",
  "einstBackupAutoHinweis": "Runs only while the app is open (there is no background service) – it checks at start-up and every 30 minutes afterwards whether the interval has elapsed. Always encrypted, and alongside the original files it saves a snapshot of the whole database (faces, places, tags, albums, favourites, …) so the complete state can be restored after data loss. It never deletes anything at the destination – local deletions are deliberately not mirrored.",
  "einstBackupZuerstZiel": "Choose a destination folder first.",
  "einstBackupKeinOrdner": "No folder chosen.",
  "einstBackupAutoZielWaehlen": "Choose the destination for automatic backups",
  "einstWaehlen": "Choose…",
  "einstStuendlich": "Hourly",
  "einstTaeglich": "Daily",
  "einstWoechentlich": "Weekly",
  "einstBackupGrenzeText": "Caps how much each run writes to the destination. Worth setting for cloud folders: otherwise the upload falls behind for days. The rest follows at the next interval.",
  "einstNieAusgefuehrt": "Never run.",
  "einstBackupPassphraseGesperrt": "The backup passphrase still needs unlocking for this session before the automatic backup can run – via “Sync now”, for instance.",
  "einstPapierkorbText": "Permanently deletes photos and videos once the chosen period has passed since they went to the trash – irreversibly, including from the locked folder's PIN-protected trash. Off by default.",
