  "werkzAbschnittVorschau": "Previews",
  "werkzHeicTitel": "HEIC/HEIF & RAW support",
  "werkzHeicAktiv": "Active – iPhone photos (HEIC) and RAW files (DNG, CR2/CR3, NEF, ARW, RAF, ORF, RW2 and the rest) go through native macOS image conversion.",
  "werkzHeicInaktiv": "Inactive – the native Swift file still has to be added to the Xcode project (see the README). JPG/PNG/WebP/GIF/BMP/TIFF work without it.",
  "werkzHeicWerkzeugeAktiv": "Active – iPhone photos (HEIC) and RAW files (DNG, CR2/CR3, NEF, ARW, RAF, ORF, RW2 and the rest) go through the bundled tools.",
  "werkzHeicWerkzeugeFehlen": "Limited – missing: {namen}. The formats that depend on them stay without a preview; JPG/PNG/WebP/GIF/BMP/TIFF keep working.",
  "werkzNeuRendernTitel": "Re-render developed photos",
  "werkzAbschnittOrte": "Locations",
  "werkzOrteAufloesenTitel": "Resolve country/region/city",
  "werkzAbschnittKamera": "Camera",
  "werkzPresetsTitel": "Manage camera presets",
  "werkzPresetsText": "Automatically put photos from a particular camera into an album or tag, or mark them as favourites, as they are imported – digiKam's \"preset the camera for import\" by another name.",
  "werkzRegelnTitel": "Manage automation rules",
  "werkzRegelnText": "Automatically put photos into an album or tag, or mark them as favourites, based on location, AI tag or capture date – like camera presets, but for other conditions.",
  "werkzAllesNachholenTitel": "Catch up on all analysis now",
  "werkzAllesNachholenText": "Starts every expensive step one after another in the background: blur, faces, text recognition, image search, tags and captions. Each step skips what it already has, and the app stays usable throughout.",
  "werkzAbschnittBibliothek": "Library",
  "werkzSichtenTitel": "Cull unrated photos",
  "werkzSichtenText": "Opens every photo and video that is still unrated in full-screen culling mode, for going through and rating them quickly.",
  "werkzDuplikateTitel": "Find duplicates & similar photos",
  "werkzDuplikateText": "Based on the CLIP image embeddings",
  "werkzStapelTitel": "Group burst shots",
  "werkzStapelText": "Finds similar photos taken close together in time – burst shots, typically – and, if you want, collapses them into one stack with a cover image.",
  "werkzIntegritaetTitel": "Library integrity check",
  "werkzIntegritaetText": "Compares the database against the files actually on disk: missing files, orphaned files and, if you like, checksum mismatches.",
  "werkzAbschnittInterop": "Interoperability",
