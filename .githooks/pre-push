#!/usr/bin/env bash
# Runs the quick CI checks before a push to main or a tag, so a broken state
# never reaches Gitea and from there the GitHub mirror (each failed run there
# sends a mail). Native platform builds stay with the CI.
#
# Set up once per clone:  git config core.hooksPath .githooks
# Skip once:              git push --no-verify
set -euo pipefail

zero=0000000000000000000000000000000000000000
remote=${1:-origin}
commit=""
# Nur Tags, deren Commit der Server auf main schon hat? Den hat dieser
# Hook beim Push von main geprüft. release.py vorbereiten pusht erst main,
# dann die Marke – und der zweite volle Lauf kostete jede Fassung eine
# Viertelstunde (#287).
schon_geprueft=1
while read -r _ local_sha remote_ref _; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  case "$remote_ref" in
    refs/heads/main)
      commit=$(git rev-parse "$local_sha^{commit}")
      schon_geprueft=0
      ;;
    refs/tags/*)
      commit=$(git rev-parse "$local_sha^{commit}")
      if ! git rev-parse -q --verify "refs/remotes/$remote/main" >/dev/null ||
        ! git merge-base --is-ancestor "$commit" "refs/remotes/$remote/main"; then
        schon_geprueft=0
      fi
      ;;
  esac
done
[ -z "$commit" ] && exit 0
if [ "$schon_geprueft" = 1 ]; then
  # Die Datenschutzprüfung trotzdem: Sie liest auch die Marken, und sie
  # dauert Sekunden.
  cd "$(git rev-parse --show-toplevel)"
  if ! tool/pruefe_repository_datenschutz.sh >&2; then
    echo "pre-push: failed: tool/pruefe_repository_datenschutz.sh (push cancelled; skip with --no-verify)" >&2
    exit 1
  fi
  echo "pre-push: $(git rev-parse --short "$commit") liegt geprüft auf $remote/main – nur Datenschutz" >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel)
# Each run logs to a file of its own: hooks of other repositories may run at
# the same time and would otherwise write into the same log.
log=$(mktemp "${TMPDIR:-/tmp}/photo_vault-pre-push.XXXXXX")
worktree=""
cleanup() {
  rm -f "$log"
  if [ -n "$worktree" ]; then
    git -C "$root" worktree remove --force "$worktree" >/dev/null 2>&1 ||
      rm -rf "$worktree"
  fi
}
trap cleanup EXIT
# Test exactly what is pushed: the checkout itself when it matches, otherwise
# a throwaway worktree of the pushed commit.
if [ "$(git rev-parse HEAD)" = "$commit" ] &&
  [ -z "$(git status --porcelain --untracked-files=no)" ]; then
  dir=$root
else
  worktree=$(mktemp -d)
  dir=$worktree
  git worktree add --detach --quiet "$dir" "$commit"
fi
# Ab hier findet jeder Schritt das Repo über seinen Ordner. Git gibt einem
# Hook in einem Worktree GIT_DIR als absoluten Pfad mit
# (.git/worktrees/<name>), im Haupt-Checkout gar nicht. Erbt Flutter es,
# liest es seine eigene Fassung per `git describe` aus diesem Repo statt
# aus dem SDK („Flutter SDK version is 0.8.0“), und `flutter pub get`
# scheitert. Die übrigen Variablen gehören zum selben Satz.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
cd "$dir"

step() {
  echo "pre-push: $*" >&2
  if ! "$@" >"$log" 2>&1; then
    tail -n 60 "$log" >&2
    echo "pre-push: failed: $* (push cancelled; skip with --no-verify)" >&2
    exit 1
  fi
}

step tool/pruefe_repository_datenschutz.sh
step python3 -B -m unittest discover -s tool/tests -p 'test_*.py'
# Erst die Pakete, wie in der CI: In einer frischen Kopie fehlt sonst
# .dart_tool, und dart format nimmt ohne analysis_options und Sprachversion
# andere Regeln – sauberer Code gilt dann als unformatiert.
step flutter pub get
step bash -c "cd packages/kern && dart pub get"
step bash -c "cd packages/server && dart pub get"
step bash -c "cd apps/mobil && flutter pub get"
# Dieselben Ordner wie in der CI. Die erzeugten Dateien (drift,
# Übersetzungen) sind mit gemeint: Beide Generatoren schreiben bereits
# formatiert.
step dart format --output=none --set-exit-if-changed lib test tool integration_test docs packages apps
step bash -c "flutter analyze && flutter test"
step bash -c "cd packages/server && dart test"
step bash -c "cd apps/mobil && flutter test"
echo "pre-push: all checks passed" >&2
